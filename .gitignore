# Godot
.godot/
/game/.godot/
/game/android/
*.translation

# export_presets.cfg est VOLONTAIREMENT suivi, contrairement a l'habitude.
# Godot l'exclut par defaut parce qu'il peut contenir des mots de passe de
# signature ou des chemins de machine ; le notre ne contient que des reglages
# de build. Le partager evite que chacun refasse la configuration a la main
# et produise un executable different.

# Builds — on attache les exécutables aux releases, jamais au dépôt
/build/
/dist/
*.exe
*.pck
*.zip

# Blender — fichiers de sauvegarde automatique
*.blend1
*.blend2
*.blend3
*.blend@

# Python
__pycache__/
*.pyc
.venv/

# Temporaires du projet — tout ce qui est régénérable
.tmp/

# Originaux générés par IA — le sas avant intégration.
#
# Ils ne rentrent pas dans git, pour la même raison que le dossier ci-dessous :
# un binaire commité reste dans l'historique même après suppression. Un modèle
# en qualité « detailed » pèse des dizaines de Mo, et la CI de release fait un
# checkout LFS complet à CHAQUE tag — le quota se viderait en un build.
#
# Ce qui est versionné à la place, c'est outils/assets-ia.json : le prompt, le
# modèle, les paramètres et l'empreinte du fichier. C'est LUI la source. Un
# original perdu se régénère ; un manifeste perdu ne se retrouve pas.
livraisons/ia/

# Sauvegardes ecrites par alleger_textures.py avant de reecrire un .glb.
# Ce sont les ORIGINAUX lourds — celui de l'Aztek pesait 10 Mo a lui seul, et
# git checkout suffit a les retrouver puisque game/assets/ est versionne.
*.glb.avant-allegement

# Médias issus de la série — référence, placeholders, sources sonores.
# Ne rentrent JAMAIS dans git : un binaire commité reste dans l'historique
# même après suppression, et l'en sortir casse les clones existants.
# Synchronisés entre nous par un autre canal. Voir DISCLAIMER.md.
assets-ref/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Redirection POSIX interpretee comme un chemin par Windows : git lfs install
# y a deja ecrit ses hooks. Rien de ce qui atterrit la n'a de sens.
/dev/

# Ecrit par bg.ps1 avant chaque lancement : numero de commit courant. Il change
# a chaque commit, donc le suivre creerait une modification permanente.
/game/donnees/version.json
