# Godot
.godot/
/game/.godot/
/game/android/
export_presets.cfg
*.translation

# Builds — on attache les exécutables aux releases, jamais au dépôt
/build/
/dist/
*.exe
*.pck
*.zip

# Blender — fichiers de sauvegarde automatique
*.blend1
*.blend2
*.blend3
*.blend@

# Python
__pycache__/
*.pyc
.venv/

# Temporaires du projet — tout ce qui est régénérable
.tmp/

# Médias issus de la série — référence, placeholders, sources sonores.
# Ne rentrent JAMAIS dans git : un binaire commité reste dans l'historique
# même après suppression, et l'en sortir casse les clones existants.
# Synchronisés entre nous par un autre canal. Voir DISCLAIMER.md.
assets-ref/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Redirection POSIX interpretee comme un chemin par Windows : git lfs install
# y a deja ecrit ses hooks. Rien de ce qui atterrit la n'a de sens.
/dev/
