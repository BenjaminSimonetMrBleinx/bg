[physics]

3d/default_gravity=14.0

[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
scaling_3d/mode=0

[importer_defaults]

; Godot EXTRAIT par defaut les images d un .glb dans un PNG pose a cote, et
; les .import se mettent alors a dependre de ce fichier. Supprimer le PNG —
; en croyant nettoyer un doublon — casse l import du modele, le maillage
; disparait de la scene, et le jeu se lance quand meme sans dire un mot.
; C est exactement comme ca que Walter s est volatilise.
;
; Nos textures sont deja cuites dans le .glb par les generateurs Blender : on
; n a rien a extraire. 3 = les garder embarquees, non compressees.
scene={
"gltf/embedded_image_handling": 3
}
