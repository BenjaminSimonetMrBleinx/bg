; Le desert. Pose a neuf cents metres de la ville, dans CE monde et pas dans
; une autre scene — exactement comme les interieurs de maison. Voir l'en-tete
; de systemes/desert.gd : c'est un choix, et il economise un mecanisme entier.
[node name="Desert" type="Node3D" parent="Rendu/Scene3D"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 900, 0, -900)
script = ExtResource("23_desert")
reglages = ExtResource("2_reglages")
geometrie = ExtResource("25_sol_desert")
camping_car = ExtResource("26_camping_car")

; Le passage du retour, sur la piste juste derriere le point d'arrivee. Il
; n'exige pas de vehicule : quelqu'un qui descend de voiture la-bas resterait
; coince, et un cul-de-sac est un bug meme quand il est logique.
[node name="RetourVille" type="Area3D" parent="Rendu/Scene3D/Desert"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 156)
collision_layer = 0
collision_mask = 7
script = ExtResource("24_passage")
destination = Vector3(8.5, 0.4, -118)
cap_degres = 0.0
exige_vehicule = true

[node name="Forme" type="CollisionShape3D" parent="Rendu/Scene3D/Desert/RetourVille"]
shape = SubResource("passage_forme")

; Le panneau DESERT et la fleche au sol, au bout de la route ouest. La fleche
; est peinte SUR la chaussee : on la franchit en roulant, on ne la contourne
; pas.
; L Alpine. Anachronique et voulue comme telle : dans une rue de pick-up
; beiges, la seule teinte saturee du parc. Ancree comme le reste — elle suivra
; les maisons si la grille bouge encore.
[node name="Alpine" type="Node3D" parent="Rendu/Scene3D"]
script = ExtResource("30_ancrage")
lieu = "alpine"

[node name="Caisse" parent="Rendu/Scene3D/Alpine" instance=ExtResource("31_alpine")]

; L EPICERIE, au centre commercial le plus ELOIGNE du point de depart : 283 m,
; a l autre bout de la ville. La distance est le sujet — une course qui ne
; detourne pas n est pas un choix, c est un bouton. Voir #31.
;
; Reutilisable a l infini : faire les courses n est pas un evenement de mission,
; c est quelque chose qu on refait ou qu on neglige.
[node name="Epicerie" type="Node3D" parent="Rendu/Scene3D"]
script = ExtResource("30_ancrage")
lieu = "strip_mall_0_4"
suivre_le_cap = false

[node name="Courses" type="Node3D" parent="Rendu/Scene3D/Epicerie"]
script = ExtResource("39_point")
invite = "Faire les courses"
evenement = "courses"
une_fois = false
portee = 3.0

; Le panneau DESERT et sa fleche. Le noeud ne porte PLUS de coordonnees : il
; s'ancre sur le lieu nomme que le generateur publie. Deux elargissements de
; rue ont deja depose ce panneau au milieu de la chaussee ; un lieu nomme se
; recalcule, une coordonnee ecrite a la main non.
[node name="VersDesert" type="Node3D" parent="Rendu/Scene3D"]
script = ExtResource("30_ancrage")
lieu = "sortie_desert"
suivre_le_cap = false

[node name="Fleche" parent="Rendu/Scene3D/VersDesert" instance=ExtResource("27_fleche")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -4)

[node name="Panneau" parent="Rendu/Scene3D/VersDesert" instance=ExtResource("28_panneau")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 7, 0, -2)

[node name="Zone" type="Area3D" parent="Rendu/Scene3D/VersDesert"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, -4)
collision_layer = 0
collision_mask = 7
script = ExtResource("24_passage")
cap_degres = 180.0
exige_vehicule = true
refus = "Il vous faut une voiture pour quitter la ville"
zone = "camping"
; Le desert n'existe qu'une fois qu'on sait pourquoi on y va. On pouvait
; auparavant filer au camping-car des la premiere minute, y trouver un Jesse
; qui reprochait un retard a une mission pas encore commencee, et revenir sans
; comprendre ce qu'on venait de voir.
etape_minimale = "voiture"
refus_etape = "Rien ne vous attend dans le desert pour l'instant"

[node name="Forme" type="CollisionShape3D" parent="Rendu/Scene3D/VersDesert/Zone"]
shape = SubResource("passage_forme")
; La circulation. Les voitures suivent le graphe des rues publie par le
; generateur — sur graphe, jamais en physique : la simulation avec changement
; de voie est l endroit precis ou les projets a deux meurent.
[node name="Trafic" type="Node3D" parent="Rendu/Scene3D"]
script = ExtResource("32_trafic")
reglages = ExtResource("2_reglages")

; Les passants. Leurs trajets viennent du generateur de ville, comme les
; lampadaires : une ville regeneree repeuple ses trottoirs toute seule.
[node name="Foule" type="Node3D" parent="Rendu/Scene3D"]
script = ExtResource("22_foule")
reglages = ExtResource("2_reglages")

; Les deux maisons occupent la parcelle reservee sur la facade sud de l'ilot
; (0, 0) — voir RESERVES dans outils/gen_ville.py. Elles donnent sur le
; carrefour de depart, a une vingtaine de metres du point ou commence la
; partie.
;
; Elles etaient auparavant au nord, dans le desert au-dela de la derniere
; rue, faute de place en bordure de chaussee. En jeu ca donnait deux maisons
; au bout du monde, dans le noir, sans rien pour indiquer d'y aller : on
; faisait demi-tour avant de les atteindre.
;
; Leur porte regarde +Z, donc la rue. Les interieurs sont poses tres loin, a
; des distances differentes pour qu'ils ne puissent jamais se voir l'un
; l'autre.
[node name="Maisons" type="Node3D" parent="Rendu/Scene3D"]

[node name="Walter" type="Node3D" parent="Rendu/Scene3D/Maisons"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 26, 0, -20)
script = ExtResource("11_maison")
nom_affiche = "Walter"
geometrie_ext = ExtResource("12_walter_ext")
geometrie_int = ExtResource("13_walter_int")
decalage_interieur = Vector3(-600, 0, 600)
habitant_geometrie = ExtResource("17_skyler")
habitant_cle = "skyler"

[node name="Jesse" type="Node3D" parent="Rendu/Scene3D/Maisons"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 44, 0, -19.5)
script = ExtResource("11_maison")
nom_affiche = "Jesse"
geometrie_ext = ExtResource("14_jesse_ext")
geometrie_int = ExtResource("15_jesse_int")
decalage_interieur = Vector3(-600, 0, 900)
habitant_geometrie = ExtResource("18_jesse")
habitant_cle = "jesse"
lumiere_couleur = Color(1, 0.831, 0.639, 1)
lumiere_energie = 2.6

; La voiture est garee le long de la rue du bas, donc tournee d'un quart de
; tour. Le sens a ete MESURE, pas deduit : test_sens.gd applique une poussee
; et projette le deplacement. Avec le quart de tour oppose, elle partait vers
; -X, c'est-a-dire vers le bord de la carte a dix metres de la.
; Les lieux de la mission 1 : le camping-car, le QG de Tuco et leurs habitants.
; Ils vivent loin sur le meme plan, comme les interieurs de maison.
[node name="Mission1" parent="Rendu/Scene3D" instance=ExtResource("40_mission1")]

; LA CACHETTE, dans le salon de Walter. Une latte du mur descellee.
;
; Elle est posee ICI et pas dans mission1.tscn parce qu'elle appartient a un
; decor qui existait avant la mission : l'interieur de la maison, a
; (26, -20) + (-600, 600).
[node name="LatteDescellee" type="Node3D" parent="Rendu/Scene3D"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -576.6, 1, 583.4)
script = ExtResource("39_point")
invite = "Cacher votre argent"
evenement = "action:cachette"
etape = "cacher"
une_fois = false
portee = 1.9

; CE QUE WALTER A CHEZ LUI, et qu'il faut aller chercher.
;
; Il partait les mains vides depuis la 0.28.0 — c'etait le correctif : le
; porkpie sur la tete des la premiere image donne la fin du personnage avant
; son debut. Mais rien ne permettait plus de les recuperer, et les deux objets
; existaient sans exister.
;
; Ils sont donc POSES DANS LE DECOR, chacun la ou on l'attend : le chapeau sur
; le porte-manteau de l'entree, le livre dans la bibliotheque. Le meuble et le
; point d'interaction sont declares a deux endroits — outils/gen_maison.py pour
; la boite, ici pour le point — et leurs coordonnees viennent du meme repere :
; l'interieur de Walter est a (26, -20) + (-600, 600), et le generateur
; construit en convention Blender, donc son y devient un z de signe oppose.
[node name="PorteManteau" type="Node3D" parent="Rendu/Scene3D"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -580.4, 1.4, 583.6)
script = ExtResource("39_point")
invite = "Prendre le chapeau"
donne = "chapeau"
portee = 1.7

[node name="Bibliotheque" type="Node3D" parent="Rendu/Scene3D"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -580.5, 1.2, 579.6)
script = ExtResource("39_point")
invite = "Prendre le livre"
donne = "livre"
portee = 1.7

[node name="Vehicule" parent="Rendu/Scene3D" instance=ExtResource("5_vehicule")]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 17, 0.6, -7)

; Sur le trottoir devant chez Walter, assez pres pour la voir, assez loin
; pour qu'aucune invite ne s'affiche avant d'avoir fait un pas. Il regarde
; -Z, donc les maisons.
[node name="Joueur" parent="Rendu/Scene3D" instance=ExtResource("7_joueur")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 23.5, 0.3, -12)
