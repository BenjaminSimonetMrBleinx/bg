etiquette_nom = NodePath("../Rendu/Interface/CadreDialogue/Marge/Colonne/Qui")
etiquette_texte = NodePath("../Rendu/Interface/CadreDialogue/Marge/Colonne/Texte")

; L horloge du monde. Un seul noeud avance l heure et previent les autres :
; sans ce point unique, le ciel et les lampadaires divergeraient d une image.
; Figee par defaut — voir temps_vitesse dans reglages.tres.
[node name="Temps" type="Node" parent="."]
script = ExtResource("29_temps")
reglages = ExtResource("2_reglages")
rendu = NodePath("..")
ville = NodePath("../Rendu/Scene3D/Ville")

; ------------------------------------------------------------- la mission 1
;
; Quatre noeuds, et ils se cherchent par GROUPE plutot que par chemin : la
; mission et la bourse sont lues depuis le HUD, le scenario et la cachette,
; et cinq chemins ecrits a la main se seraient contredits au premier
; deplacement de noeud.

[node name="Mission" type="Node" parent="."]
script = ExtResource("33_mission")

[node name="Bourse" type="Node" parent="."]
script = ExtResource("34_bourse")

; Sauvegarder et reprendre. Se cable sur les systemes qui portent l'etat a
; ecrire : l'heure, l'argent, l'inventaire, la position, la mission. Le monde,
; lui, ne se sauve pas - il se regenere.
[node name="Sauvegarde" type="Node" parent="."]
script = ExtResource("44_sauvegarde")
bourse = NodePath("../Bourse")
purete = NodePath("../Purete")
temps = NodePath("../Temps")

; La purete du produit. Elle ne s'affiche nulle part : elle teinte le cristal
; tenu en main, et c'est tout ce que le joueur en percoit.
[node name="Purete" type="Node" parent="."]
script = ExtResource("47_purete")
equipement = NodePath("../Equipement")

; Les points de famille. Un seul compteur pour Skyler, Junior et Hank : ce
; qu'on suit, c'est la place qu'on laisse a sa vie d'avant. Affiche en
; permanence dans le HUD — c'est le seul chiffre du jeu qui se montre.
[node name="Famille" type="Node" parent="."]
script = ExtResource("48_famille")

; La reputation de rue. Elle ne se depense jamais : elle OUVRE. Affichee comme
; les deux autres compteurs — decision du 06/08/2026.
[node name="Reputation" type="Node" parent="."]
script = ExtResource("49_reputation")
equipement = NodePath("../Equipement")

; Les outils de test. Il n'appartient pas au jeu : rien ne l'appelle, c'est le
; menu pause qui l'affiche et le declenche. Le retirer de la scene fait
; disparaitre la ligne du menu, sans rien casser d'autre.
[node name="Dev" type="Node" parent="."]
script = ExtResource("45_dev")
reglages = ExtResource("2_reglages")
bourse = NodePath("../Bourse")
equipement = NodePath("../Equipement")
joueur = NodePath("../Rendu/Scene3D/Joueur")
vehicule = NodePath("../Rendu/Scene3D/Vehicule")
foule = NodePath("../Rendu/Scene3D/Foule")
trafic = NodePath("../Rendu/Scene3D/Trafic")
jauge = NodePath("../Rendu/Interface/JaugePerf")
purete = NodePath("../Purete")
service = NodePath("../Rendu/Interface/ServiceTest")
