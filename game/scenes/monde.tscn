[sub_resource type="ViewportTexture" id="tex_ecran"]
viewport_path = NodePath("Rendu")

[sub_resource type="Environment" id="env"]
background_mode = 1

[sub_resource type="StyleBoxFlat" id="fond_dialogue"]
bg_color = Color(0.055, 0.063, 0.09, 0.867)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.322, 0.298, 0.243, 1)

[sub_resource type="BoxShape3D" id="passage_forme"]
size = Vector3(9, 3, 5)

[node name="Monde" type="Node"]
script = ExtResource("1_rendu")
reglages = ExtResource("2_reglages")

[node name="Rendu" type="SubViewport" parent="."]
size = Vector2i(512, 384)
render_target_update_mode = 4
audio_listener_enable_3d = true

[node name="Environnement" type="WorldEnvironment" parent="Rendu"]
environment = SubResource("env")

[node name="Scene3D" type="Node3D" parent="Rendu"]

[node name="Ville" type="Node3D" parent="Rendu/Scene3D"]
script = ExtResource("3_ville")
reglages = ExtResource("2_reglages")
geometrie = ExtResource("4_geometrie")

; Le desert. Pose a neuf cents metres de la ville, dans CE monde et pas dans
; une autre scene — exactement comme les interieurs de maison. Voir l'en-tete
; de systemes/desert.gd : c'est un choix, et il economise un mecanisme entier.
[node name="Desert" type="Node3D" parent="Rendu/Scene3D"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 900, 0, -900)
script = ExtResource("23_desert")
reglages = ExtResource("2_reglages")
geometrie = ExtResource("25_sol_desert")
camping_car = ExtResource("26_camping_car")

; Le passage du retour, sur la piste juste derriere le point d'arrivee. Il
; n'exige pas de vehicule : quelqu'un qui descend de voiture la-bas resterait
; coince, et un cul-de-sac est un bug meme quand il est logique.
[node name="RetourVille" type="Area3D" parent="Rendu/Scene3D/Desert"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 156)
collision_layer = 0
collision_mask = 7
script = ExtResource("24_passage")
destination = Vector3(7, 0.4, -104)
cap_degres = 0.0
exige_vehicule = true

[node name="Forme" type="CollisionShape3D" parent="Rendu/Scene3D/Desert/RetourVille"]
shape = SubResource("passage_forme")

; Le panneau DESERT et la fleche au sol, au bout de la route ouest. La fleche
; est peinte SUR la chaussee : on la franchit en roulant, on ne la contourne
; pas.
[node name="VersDesert" type="Node3D" parent="Rendu/Scene3D"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 7, 0, -112)

[node name="Fleche" parent="Rendu/Scene3D/VersDesert" instance=ExtResource("27_fleche")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -4)

[node name="Panneau" parent="Rendu/Scene3D/VersDesert" instance=ExtResource("28_panneau")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 12.4, 0, -2)

[node name="Zone" type="Area3D" parent="Rendu/Scene3D/VersDesert"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, -4)
collision_layer = 0
collision_mask = 7
script = ExtResource("24_passage")
cap_degres = 180.0
exige_vehicule = true

[node name="Forme" type="CollisionShape3D" parent="Rendu/Scene3D/VersDesert/Zone"]
shape = SubResource("passage_forme")
; Les passants. Leurs trajets viennent du generateur de ville, comme les
; lampadaires : une ville regeneree repeuple ses trottoirs toute seule.
[node name="Foule" type="Node3D" parent="Rendu/Scene3D"]
script = ExtResource("22_foule")
reglages = ExtResource("2_reglages")

; Les deux maisons occupent la parcelle reservee sur la facade sud de l'ilot
; (0, 0) — voir RESERVES dans outils/gen_ville.py. Elles donnent sur le
; carrefour de depart, a une vingtaine de metres du point ou commence la
; partie.
;
; Elles etaient auparavant au nord, dans le desert au-dela de la derniere
; rue, faute de place en bordure de chaussee. En jeu ca donnait deux maisons
; au bout du monde, dans le noir, sans rien pour indiquer d'y aller : on
; faisait demi-tour avant de les atteindre.
;
; Leur porte regarde +Z, donc la rue. Les interieurs sont poses tres loin, a
; des distances differentes pour qu'ils ne puissent jamais se voir l'un
; l'autre.
[node name="Maisons" type="Node3D" parent="Rendu/Scene3D"]

[node name="Walter" type="Node3D" parent="Rendu/Scene3D/Maisons"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 26, 0, -20)
script = ExtResource("11_maison")
nom_affiche = "Walter"
geometrie_ext = ExtResource("12_walter_ext")
geometrie_int = ExtResource("13_walter_int")
decalage_interieur = Vector3(-600, 0, 600)
habitant_geometrie = ExtResource("17_skyler")
habitant_cle = "skyler"

[node name="Jesse" type="Node3D" parent="Rendu/Scene3D/Maisons"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 44, 0, -19.5)
script = ExtResource("11_maison")
nom_affiche = "Jesse"
geometrie_ext = ExtResource("14_jesse_ext")
geometrie_int = ExtResource("15_jesse_int")
decalage_interieur = Vector3(-600, 0, 900)
habitant_geometrie = ExtResource("18_jesse")
habitant_cle = "jesse"
lumiere_couleur = Color(1, 0.831, 0.639, 1)
lumiere_energie = 2.6

; La voiture est garee le long de la rue du bas, donc tournee d'un quart de
; tour. Le sens a ete MESURE, pas deduit : test_sens.gd applique une poussee
; et projette le deplacement. Avec le quart de tour oppose, elle partait vers
; -X, c'est-a-dire vers le bord de la carte a dix metres de la.
[node name="Vehicule" parent="Rendu/Scene3D" instance=ExtResource("5_vehicule")]
transform = Transform3D(0, 0, -1, 0, 1, 0, 1, 0, 0, 17, 0.6, -7)

; Sur le trottoir devant chez Walter, assez pres pour la voir, assez loin
; pour qu'aucune invite ne s'affiche avant d'avoir fait un pas. Il regarde
; -Z, donc les maisons.
[node name="Joueur" parent="Rendu/Scene3D" instance=ExtResource("7_joueur")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 23.5, 0.3, -12)
camera = NodePath("../../Camera3D")

[node name="Camera3D" type="Camera3D" parent="Rendu"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 9.2, 2.2, -17)
fov = 70.0
near = 0.15
far = 400.0
script = ExtResource("6_camera")
reglages = ExtResource("2_reglages")
cible = NodePath("../Scene3D/Joueur")

; L'interface vit DANS le SubViewport, donc rendue a 512x384 comme le reste.
; Un texte net superpose a une image basse resolution trahirait immediatement
; un jeu moderne — les HUD PS2 partageaient le meme tampon que la 3D.
[node name="Interface" type="CanvasLayer" parent="Rendu"]

[node name="Invite" type="Label" parent="Rendu/Interface"]
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -46.0
grow_horizontal = 2
grow_vertical = 0
theme_override_colors/font_color = Color(0.949, 0.925, 0.867, 1)
theme_override_colors/font_outline_color = Color(0.043, 0.055, 0.086, 1)
theme_override_constants/outline_size = 5
theme_override_font_sizes/font_size = 17
horizontal_alignment = 1
vertical_alignment = 1

; Le cadre de dialogue, en bas de l'ecran comme sur PS2. Il est cache tant
; qu'aucune conversation ne tourne.
[node name="CadreDialogue" type="PanelContainer" parent="Rendu/Interface"]
visible = false
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = -186.0
offset_right = -20.0
offset_bottom = -12.0
grow_horizontal = 2
grow_vertical = 0
theme_override_styles/panel = SubResource("fond_dialogue")

[node name="Marge" type="MarginContainer" parent="Rendu/Interface/CadreDialogue"]
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 7
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 7

[node name="Colonne" type="VBoxContainer" parent="Rendu/Interface/CadreDialogue/Marge"]
theme_override_constants/separation = 3

[node name="Qui" type="Label" parent="Rendu/Interface/CadreDialogue/Marge/Colonne"]
theme_override_colors/font_color = Color(0.949, 0.776, 0.42, 1)
theme_override_font_sizes/font_size = 15

[node name="Texte" type="Label" parent="Rendu/Interface/CadreDialogue/Marge/Colonne"]
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.949, 0.941, 0.914, 1)
theme_override_font_sizes/font_size = 15
autowrap_mode = 3

[node name="Hud" type="Control" parent="Rendu/Interface"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("21_hud")
reglages = ExtResource("2_reglages")
vehicule = NodePath("../../Scene3D/Vehicule")
equipement = NodePath("../../../Equipement")
controleur = NodePath("../../../Controleur")

; La roue des outils. Sous le fondu, pour qu'un passage de porte la recouvre
; si elle etait restee ouverte.
[node name="Roue" type="Control" parent="Rendu/Interface"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("20_roue")
reglages = ExtResource("2_reglages")
equipement = NodePath("../../../Equipement")

; Le telephone. Dessine par-dessus la roue : les deux ne s'ouvrent jamais en
; meme temps, mais si ca arrivait c'est le combine qu'on veut voir.
[node name="Telephone" type="Control" parent="Rendu/Interface"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("21_telephone")
reglages = ExtResource("2_reglages")

; Le fondu de porte. Declare APRES l'invite, donc dessine par-dessus : pendant
; le noir, plus rien ne doit rester lisible a l'ecran.
[node name="Fondu" type="ColorRect" parent="Rendu/Interface"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 0)

[node name="Audio" type="Node" parent="."]
script = ExtResource("9_audio")
reglages = ExtResource("2_reglages")
