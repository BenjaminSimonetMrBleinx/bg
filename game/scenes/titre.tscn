; L'ecran-titre, premiere scene du jeu (main_scene). Il charge monde.tscn quand
; on choisit Reprendre ou Nouvelle partie.
;
; MEME PIPELINE QUE LE JEU : le menu est dessine dans le SubViewport "Rendu" a
; la resolution de reglages.tres, puis agrandi par "Affichage/Ecran". Sans ca,
; le premier ecran est plus net que la premiere image de jeu.
;
; L'etat et les actions vivent dans titre.gd, le dessin dans menu_titre.gd.

[gd_scene load_steps=4 format=3 uid="uid://bgtitre0v00001"]

[ext_resource type="Script" path="res://systemes/titre.gd" id="1_titre"]
[ext_resource type="Resource" path="res://systemes/reglages.tres" id="2_reglages"]
[ext_resource type="Script" path="res://systemes/menu_titre.gd" id="3_menu"]

[sub_resource type="ViewportTexture" id="tex_titre"]
viewport_path = NodePath("Rendu")

[node name="Titre" type="Node"]
script = ExtResource("1_titre")
reglages = ExtResource("2_reglages")

[node name="Rendu" type="SubViewport" parent="."]
size = Vector2i(512, 384)
render_target_update_mode = 4

[node name="Menu" type="Control" parent="Rendu"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("3_menu")

[node name="Affichage" type="CanvasLayer" parent="."]
layer = -1

[node name="Ecran" type="TextureRect" parent="Affichage"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = SubResource("tex_titre")
expand_mode = 1
stretch_mode = 1
