[sub_resource type="BoxShape3D" id="zone_qg"]
size = Vector3(14, 4, 14)

; LES COLLISIONS SONT POSEES A LA MAIN, en boites.
;
; Godot sait fabriquer une collision depuis un maillage importe, mais il la
; refabrique a chaque reimport du .glb — et ces trois decors sont regeneres par
; Blender a chaque retouche. Trois boites par piece tiennent la meme fonction,
; ne se perdent jamais, et coutent infiniment moins cher a la physique qu'un
; maillage de trois cents faces.
; Les cotes suivent CC_L, CC_P et CC_H dans outils/gen_lieux.py. Le camping-car
; a ete elargi a 3,40 m — la camera sortait par la paroi et le mobilier ne
; pouvait pas etre solide sans fermer le couloir. Ces boites doivent bouger
; avec lui : une collision restee a l'ancienne largeur laisse un mur invisible
; au milieu de la piece.
[sub_resource type="BoxShape3D" id="dalle_cc"]
size = Vector3(3.4, 0.2, 8.2)

[sub_resource type="BoxShape3D" id="mur_cc_long"]
size = Vector3(0.2, 2.3, 8.2)

[sub_resource type="BoxShape3D" id="mur_cc_bout"]
size = Vector3(3.4, 2.3, 0.2)

; LE MOBILIER DU LABO EST SOLIDE.
;
; On traversait les paillasses, l'atelier et les sieges : la piece etait un
; couloir vide habille d'images. Elle est maintenant assez large pour que tout
; soit franc de collision et qu'il reste 2,15 m de passage au milieu.
[sub_resource type="BoxShape3D" id="paillasse_g"]
size = Vector3(0.62, 0.94, 6.3)

[sub_resource type="BoxShape3D" id="paillasse_d"]
size = Vector3(0.55, 0.94, 1.9)

[sub_resource type="BoxShape3D" id="atelier_cc"]
