[node name="Verrerie4" parent="CampingCarInterieur" instance=ExtResource("51_verrerie")]
transform = Transform3D(-0.94, 0, -0.342, 0, 1, 0, 0.342, 0, -0.94, -1.18, 0.94, 1.4)

; LE FUT ET LE JERRYCAN, au sol pres de l'entree.
;
; Le cote droit est occupe de z = 2,3 a 6,5 par les bidons du generateur ; on
; se pose donc avant, entre l'entree et eux.
;
; LES DEUX OBJETS SONT DANS LE MEME MODELE, et c'est une erreur de brief plus
; qu'un defaut : l'image de reference en montrait deux, Tripo en a fait un seul
; bloc. On ne peut donc pas les separer ni les repartir. Pour la suite : une
; image de reference = UN objet, sinon on perd le placement.
; Le X est a 1,10 et pas plus : tourne d'un quart de tour le couple mesure
; 1,08 m de large, et la coque s'arrete a 1,70. A 1,30 il ressortait de
; quatorze centimetres a travers la paroi — invisible depuis le couloir, et
; parfaitement visible du dehors.
[node name="Bidons" parent="CampingCarInterieur" instance=ExtResource("52_bidons")]
transform = Transform3D(0.766, 0, 0.643, 0, 1, 0, -0.643, 0, 0.766, 1.1, 0, 1.7)

[node name="Atelier" type="Node3D" parent="CampingCarInterieur"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.85, 1, 3.8)
script = ExtResource("2_point")
invite = "Cuisiner"
evenement = "objet:botte"
donne = "botte"
etape = "cuisiner"
portee = 1.9

; LE MEME ATELIER, UNE FOIS LA MISSION FINIE.
;
; Celui du dessus n'existe QUE pendant l'etape « cuisiner » : c'est ce qui
; empeche de cuisiner avant d'etre arrive. Une fois la mission bouclee, il
; disparaissait avec elle et le camping-car devenait un decor — on ne pouvait
; plus rien produire, donc plus rien vendre.
;
; Celui-ci prend le relais a partir de la derniere etape et ne s'epuise pas.
; Il rend de la marchandise, pas la botte secrete : la botte etait une scene,
; la meth est un metier.
;
; Sa teinte suit le palier de purete sans qu'on ait rien a dire — systemes/
; purete.gd teinte l'objet « meth » partout ou il apparait.
[node name="AtelierLibre" type="Node3D" parent="CampingCarInterieur"]
