[sub_resource type="BoxShape3D" id="siege_cc"]
size = Vector3(0.6, 1.26, 0.64)

[sub_resource type="BoxShape3D" id="tableau_bord"]
size = Vector3(3.3, 0.48, 0.54)

; LA FUMEE DE L'ATELIER.
;
; Elle est legere, lente et rare : une vingtaine de bouffees qui montent et se
; dissolvent. Une fumee franche transformerait le camping-car en incendie, et
; surtout elle mangerait le decor qu'on vient de detailler — on ne verrait
; plus la verrerie.
;
; Elle est ADDITIVE et sans ombre : a cette resolution, une fumee opaque fait
; un bloc gris, alors qu'une fumee qui eclaircit se lit comme de la vapeur.
[sub_resource type="ParticleProcessMaterial" id="vapeur_proc"]
direction = Vector3(0, 1, 0)
spread = 12.0
initial_velocity_min = 0.14
initial_velocity_max = 0.32
gravity = Vector3(0, 0.05, 0)
scale_min = 0.5
scale_max = 1.3
color = Color(0.86, 0.9, 0.84, 0.16)

; LA VAPEUR EST UN SHADER, PLUS UN QUAD UNI.
;
; Le materiau precedent etait un StandardMaterial3D additif : un carre plein.
; Deux defauts, tous les deux devenus visibles quand le rendu est monte a
; 960x720 — a 512 on ne les voyait tout simplement pas.
;
;   1. Le quad se COUPAIT NET la ou il traverse la paillasse et la cuve. Une
;      arete droite au milieu d'un nuage : c'est ce que le fondu de contact
;      supprime, en lisant la profondeur de ce qui est deja dessine.
;   2. Le sprite n'avait aucune forme. Une bouffee n'est pas un carre.
;
; Le billboard reste, mais il est fait par le shader plutot que par le
; materiau : BILLBOARD_ENABLED dans render_mode aurait empeche de lire VERTEX
; en espace vue, dont le fondu de contact a besoin.
[sub_resource type="ShaderMaterial" id="vapeur_mat"]
shader = ExtResource("50_vapeur")
shader_parameter/couleur = Color(0.8, 0.86, 0.8, 0.28)
shader_parameter/douceur_contact = 0.22
shader_parameter/opacite = 0.9
shader_parameter/grain = 0.4
shader_parameter/grain_echelle = 5.0

[sub_resource type="QuadMesh" id="vapeur_quad"]
material = SubResource("vapeur_mat")
size = Vector2(0.34, 0.34)

