[node name="Mission1" type="Node3D"]

; ------------------------------------------------------ devant le camping-car
;
; Jesse attend a la porte. Le camping-car est tourne de 108 degres ; on se
; place a cote de son flanc, la ou est la porte.

; ON S'ANCRE SUR LE CAMPING-CAR, ON NE RECOPIE PLUS SA POSITION.
;
; Ce noeud portait (877, 0, -804), c'est-a-dire la constante de SECOURS de
; desert.gd — celle dont son propre en-tete dit qu'elle « n'est pas la source ».
; Depuis que le generateur publie ses lieux, le camping-car est a (904, -804) :
; vingt-neuf metres plus loin. Jesse et la porte sont restes en arriere, au
; milieu de la piste, et on a passe une semaine a croire que le desert etait
; casse alors que seule cette ligne l'etait.
;
; Sans transform : la position vient de l'ancrage et de nulle part ailleurs.
; Dans l'editeur le decor apparait donc a l'origine du monde, et c'est voulu —
; une coordonnee ecrite ici finirait par etre crue.
[node name="CampingLab" type="Node3D" parent="."]
script = ExtResource("14_ancrage")
lieu = "camping_car"
carte = "desert"
suivre_le_cap = false

; IL SE TAIT TANT QUE RIEN NE L'A AMENE LA.
;
; Son dialogue commence par « Vous etes en retard » : il n'a de sens qu'une
; fois la mission lancee. Depuis que le desert est ouvert a toute heure, on
; peut arriver ici sans avoir rien commence, et il reprochait alors un retard
; a une mission qui n'existait pas.
;
; « voiture » est l'etape ou la mission envoie chercher la voiture pour partir
; au desert — c'est exactement ce que portait le garde-fou du passage avant
; qu'on l'ouvre. La condition a change de place, pas de sens : elle est passee
; de la porte au personnage, et c'est la qu'elle aurait toujours du etre.
[node name="JesseDehors" type="Node3D" parent="CampingLab"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.02, 0, 2.0)
script = ExtResource("1_pnj")
cle = "mission_jesse_camping"
geometrie = ExtResource("7_jesse")
etape_minimale = "voiture"

; SUR LA PORTE DU MODELE, ET NULLE PART AILLEURS.
;
; Le camping-car a ete DEUX FOIS un autre vehicule : une boite generee de sept
; metres, puis — depuis le 07/08/2026 seulement — le modele livre par
; Guillaume, long de 9,20 m et oriente autrement. A chaque fois le point
; d'entree est reste ou il etait.
;
; Le commentaire precedent affirmait deja que ce point avait ete cale sur le
; modele livre. C'etait faux : la livraison n'avait jamais ete integree, et la
; capture censee le prouver photographiait du sable a vingt-neuf metres de la.
;
; Cette position-ci a ete trouvee A L'IMAGE, en posant Walter et en regardant
; ou il tombait : trois metres a gauche de la vraie porte, devant une trappe de
; soute. La porte du modele a une fenetre et une marche, on ne peut pas la
; confondre.
;
;   .\bg.ps1 capture -Scenario camping_car_porte
[node name="PorteCampingCar" type="Node3D" parent="CampingLab"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.75, 0, 1.27)
script = ExtResource("2_point")
invite = "Entrer dans le camping-car"
etape_minimale = "entrer_camping"
emmene_a = Vector3(300, 0.4, 1201)
cap_degres = 180.0
zone = "camping_interieur"
interieur = true
une_fois = false
portee = 3.2

; -------------------------------------------------- la route qui mene chez Tuco
;
; C'EST UNE AUTRE ROUTE, ET ELLE EST LOIN.
;
; Elle etait posee a vingt-cinq metres du camping-car : en remontant en voiture
; apres la cuisine, on roulait dessus sans l'avoir cherchee et l'on se
; retrouvait devant chez Tuco sans avoir eu le sentiment d'y aller. Un voyage
; qu'on n'a pas conduit n'est pas un voyage.
;
; Elle est plus bas sur la meme piste — voir PISTE dans outils/gen_desert.py :
; la bande d'asphalte court du nord au sud sur toute la longueur du terrain, il
; suffit de la descendre. Un panneau QG TUCO et une fleche peinte la signalent,
; exactement comme la sortie de la ville.
;
; DEUX FOIS DEPLACEE, et il fallait les deux. Elle etait a vingt-cinq metres du
; camping-car : on roulait dessus sans l'avoir cherchee. Repoussee a cent
; quatre-vingt-dix metres, le trajet devenait une corvee pour rien — le desert
; est vide, et cent quatre-vingt-dix metres de sable ne racontent pas plus
; qu'une route separee bien signalee. Elle est a soixante metres du camping-car,
; assez pour qu'on prenne la voiture, pas assez pour qu'on s'ennuie.
;
; Coordonnees du MONDE : le desert est a (900, -900) et le terrain fait 460 m
; de cote, donc z = -862 est largement dedans.
[node name="RouteTuco" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 900, 0, -862)

[node name="Fleche" parent="RouteTuco" instance=ExtResource("12_fleche")]

[node name="Panneau" parent="RouteTuco" instance=ExtResource("13_panneau")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 9, 0, 7)

; Elle refuse tant qu'on n'a pas la marchandise, et elle le DIT — un decor qui
; ne repond pas passe pour casse.
[node name="VersTuco" type="Area3D" parent="RouteTuco"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 0)
collision_layer = 0
collision_mask = 7
script = ExtResource("3_passage")
destination = Vector3(-1200, 0.4, -588)
; ON ARRIVE FACE AU BATIMENT, pas face a la sortie.
;
; Le cap etait a 180 degres, donc vers +Z — c'est-a-dire droit sur la zone de
; retour posee dix metres plus loin. Avec l'elan conserve a l'arrivee, la
; voiture y entrait en une seconde et repartait au desert sans qu'on ait
; touche a rien : le QG etait litteralement inaccessible.
cap_degres = 0.0
exige_vehicule = true
refus = "Il vous faut une voiture pour vous rendre chez Tuco"
zone = "qg"
etape_minimale = "aller_tuco"
refus_etape = "Vous ne pouvez pas vous rendre chez Tuco sans sa marchandise"

[node name="Forme" type="CollisionShape3D" parent="RouteTuco/VersTuco"]
shape = SubResource("zone_qg")

